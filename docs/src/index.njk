    { label: "Type safety", cells: [["Compile-time", "yes"], ["Runtime only", "no"], ["Runtime only", "no"], ["JIT inference", "partial"], ["Runtime only", "no"]] },
    { label: "Universal runtime", cells: [["Browser, server, edge", "yes"], ["OS dependent", "partial"], ["Hardware specific", "no"], ["OS dependent", "partial"], ["OS dependent", "partial"]] },
    { label: "Startup time", cells: [["Instant", "yes"], ["Module loading", "partial"], ["Fast", "yes"], ["JIT warmup", "no"], ["Import overhead", "partial"]] },
    { label: "Memory usage", cells: [["Minimal", "yes"], ["Standard", "partial"], ["Ultra-low", "yes"], ["Higher (JIT)", "no"], ["Standard", "partial"]] },
    { label: "Standard library", cells: [["Small subset", "partial"], ["Complete", "yes"], ["Subset", "partial"], ["Complete", "yes"], ["Complete", "yes"]] },
    { label: "Security", cells: [["Sandboxed WASM", "yes"], ["Full system access", "no"], ["Hardware limited", "partial"], ["Full system access", "no"], ["Full system access", "no"]] },
    { label: "Use case", cells: [["Web apps, serverless"], ["General purpose"], ["IoT, embedded"], ["CPU-intensive apps"], ["C extension API"]] }
] %}

{% set flow = [
    { name: "Project directory", sub: "compile_python_project", accent: "--c-amber",
      info: "The input: a directory of Python modules. compile_python_file starts from a single entry file instead and follows its imports." },
    { name: "Project config + file list", sub: "core::config::load_project_config", accent: "--c-green",
      info: "Reads pyproject.toml, setup.py, and __version__.py or __about__.py for the project's name and version, and collects the Python files to compile." },
    { name: "Modules + entry point", sub: "imports resolved, each module once", accent: "--c-ember",
      info: "Every module is gathered once, however many import paths reach it (from an entry file, sibling imports resolve from disk, transitively). The __main__ entry point is looked for in __main__.py first, then in the other files." },
    { name: "Source → AST → IRModule", sub: "parse_python, lower_ast_to_ir", accent: "--c-ember",
      info: "For each file: RustPython's parser turns the source into an AST, which is lowered to a typed IRModule. Module passes then desugar user decorators, metaclasses, nested functions, keyword arguments, with, and generators." },
    { name: "Merged IRModule", sub: "memory_layout.merge_from", accent: "--c-amber",
      info: "The per-file modules merge into one IRModule with one flat namespace: functions, classes, variables, and dispatch tables combine and the memory layouts merge. Two files defining the same function name is a compile error, never a silent pick." },
    { name: "Decorators + entry points", sub: "DecoratorRegistry, add_entry_point_to_module", accent: "--c-amber",
      info: "The built-in decorators are applied and a detected __main__ block becomes the entry point, which makes the program a WASI command exporting _start." },
    { name: "Compilation context", sub: "compile_ir_module", accent: "--c-green",
      info: "Lays out classes (their MRO and fields), module globals, and the module init, then generates each function through the compilation context (type tables, function indices, memory layout) with wasm-encoder. Only the runtime helpers and WASI imports the program uses are added." },
    { name: "WASM", sub: "validated, functions exported", accent: "--c-teal",
      info: "A standalone WebAssembly module, validated before it is returned, with every top-level function exported. It is already correct: nothing depends on the optimizer." },
    { name: "Optimized WASM", sub: "optimize_wasm", accent: "--c-ember",
      info: "When optimization is on, Binaryen applies its passes (dead-code elimination, constant folding, inlining, and more) for a smaller, faster binary." }
] %}

