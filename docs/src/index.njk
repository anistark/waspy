    { n: "02", title: "Typed IR", text: "Lowered to Waspy's own intermediate representation", accent: "--c-honey" },
    { n: "03", title: "WASM binary", text: "Emitted with wasm-encoder, then validated", accent: "--c-amber" },
    { n: "04", title: "Optimized", text: "Shrunk by Binaryen, when you ask for it", accent: "--c-ember" }
] %}

{% set features = [
    { title: "Ahead-of-time compilation", text: "Python compiles to a WASM binary before it runs, with no interpreter or VM in the output.", tag: "no runtime VM", accent: "--c-amber" },
    { title: "Typed code generation", text: "Type annotations map to WASM value types (i32 for ints and bools, f64 for floats), checked at compile time.", tag: "annotations", accent: "--c-teal" },
    { title: "CPython's answer, or an error", text: "A construct either gives the answer CPython gives or is refused at compile time with a located error. Nothing unsupported is silently accepted.", tag: "correctness first", accent: "--c-green" },
    { title: "Binaryen optimization", text: "The binary can run through Binaryen passes: dead-code elimination, inlining, constant folding. The unoptimized module is already valid and correct.", tag: "optimizer", accent: "--c-ember" },
    { title: "Standard WASM output", text: "Emits plain .wasm modules that load in browsers, Node.js, wasmtime, and edge runtimes. A program with a __main__ block is a WASI command.", tag: ".wasm", accent: "--c-honey" },
    { title: "Language coverage", text: "Classes with multiple inheritance, closures, lambdas, generators, comprehensions, exceptions, f-strings, and decorators.", tag: "python 3 syntax", accent: "--c-teal" },
    { title: "Small Rust API", text: "compile_python_to_wasm() for one source, compile_python_file() for an entry file and its imports, compile_python_project() for a directory.", tag: "rust crate", accent: "--c-green" },
    { title: "Project compilation", text: "Multi-file input with import resolution, __main__.py entry detection, and pyproject.toml config, linked into one .wasm. User modules resolve from disk, each compiled once.", tag: "one .wasm out", accent: "--c-amber" },
    { title: "Standard library", text: "Module constants, sys streams, argv and exit, re.sub and re.escape folded over constant arguments, and the functools decorators. Every other stdlib call is refused at compile time.", tag: "stdlib subset", accent: "--c-red" }
] %}

{% set implementations = ["Waspy", "CPython", "MicroPython", "PyPy", "HPy"] %}
{% set comparison = [
    { label: "Target", cells: [["WebAssembly"], ["Native / VM"], ["Microcontrollers"], ["JIT compilation"], ["C extensions"]] },
